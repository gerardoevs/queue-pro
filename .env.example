# ==========================================
# Firebase Client Configuration (Next.js Public)
# ==========================================
# Found in Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ==========================================
# Firebase Admin SDK Configuration (Server-Side)
# ==========================================
# Optional: Entire Service Account JSON formatted as a single stringified JSON line
# Found in Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id",...}
